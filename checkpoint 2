      "cell_type": "code",
      "source": [
        "# 1. Carregar o CSV e Análise Exploratória\n",
        "df_meteo = pd.read_csv('meteo_regressao_orange.csv')\n",
        "\n",
        "# Verificar estrutura do DataFrame\n",
        "print(df_meteo.info())\n",
        "display(df_meteo.head())\n",
        "\n",
        "# Gráfico da Radiação Média por Hora\n",
        "plt.figure(figsize=(9, 4))\n",
        "df_meteo.groupby('hora')['radiacao_w_m2'].mean().plot(kind='bar', color='orange')\n",
        "plt.title('Radiação Solar Média por Hora em Petrolina (PE)')\n",
        "plt.xlabel('Hora do Dia (7h às 17h)')\n",
        "plt.ylabel('Radiação Solar Média (W/m²)')\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.show()\n",
        "\n",
        "# Definição dos atributos (X) e do alvo (y)\n",
        "features = ['temperatura_c', 'umidade_pct', 'nuvens_pct', 'vento_kmh', 'hora']\n",
        "X = df_meteo[features]\n",
        "y = df_meteo['radiacao_w_m2']"
      ],
      "metadata": {
        "id": "P119bqKv5stF"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 2. Divisão Temporal (80% Treino / 20% Teste)\n",
        "df_meteo = df_meteo.sort_values('data_hora')\n",
        "\n",
        "split = int(len(df_meteo) * 0.8)\n",
        "\n",
        "X_train, X_test = X.iloc[:split], X.iloc[split:]\n",
        "y_train, y_test = y.iloc[:split], y.iloc[split:]\n",
        "\n",
        "print(f\"Amostras de Treino: {len(X_train)}\")\n",
        "print(f\"Amostras de Teste: {len(X_test)}\")"
      ],
      "metadata": {
        "id": "FD6PezGP5sp-"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 3. Treinar os 3 Regressores e Comparar Métricas\n",
        "modelos_reg = {\n",
        "    \"Regressão Linear\": LinearRegression(),\n",
        "    \"Árvore de Decisão\": DecisionTreeRegressor(random_state=42),\n",
        "    \"Random Forest\": RandomForestRegressor(n_estimators=100, random_state=42)\n",
        "}\n",
        "\n",
        "resultados = []\n",
        "\n",
        "for nome, modelo in modelos_reg.items():\n",
        "    modelo.fit(X_train, y_train)\n",
        "    y_pred = modelo.predict(X_test)\n",
        "\n",
        "    resultados.append({\n",
        "        \"Modelo\": nome,\n",
        "        \"MAE (W/m²)\": round(mean_absolute_error(y_test, y_pred), 2),\n",
        "        \"MSE ((W/m²)²)\": round(mean_squared_error(y_test, y_pred), 2),\n",
        "        \"R² Score\": round(r2_score(y_test, y_pred), 4)\n",
        "    })\n",
        "\n",
        "df_resultados = pd.DataFrame(resultados)\n",
        "display(df_resultados)"
